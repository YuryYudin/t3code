+    act(() => root.findByProps({ children: "Save icon" }).props.onClick());
+
+    expect(props.onSelect).toHaveBeenCalledWith({ kind: "emoji", emoji: "👩🏽‍💻" });
+    expect(props.onOpenChange).toHaveBeenCalledWith(false);
