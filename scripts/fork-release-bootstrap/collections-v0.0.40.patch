+                  maxLength={80}
+                  value={editor?.name ?? ""}
+                  onChange={(event) => {
+                    if (editor === null) return;
+                    setEditor({ ...editor, name: event.currentTarget.value });
+                    setEditorError(null);
+                  }}
+                />
+              </label>
+              <div className="flex items-center justify-between gap-3 rounded-lg border p-3">
