+
+    act(() => colorGroup.findByProps({ "aria-label": "Rose" }).props.onClick());
+    act(() => root.findByProps({ "data-icon-name": "rocket" }).props.onClick());
+
+    expect(root.findByProps({ "data-icon-name": "rocket" }).props).toMatchObject({
+      "aria-checked": true,
