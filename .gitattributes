# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
# Bootstrap patches are immutable generated release inputs; don't parse their contents as diffs.
scripts/fork-release-bootstrap/*.patch -diff
